{
  "name": "utsav",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:emulator": "npx --yes firebase-tools@15.17.0 emulators:exec --config firebase.e2e.json --only auth,firestore --project demo-utsav \"vitest run -c vitest.emulator.config.mts\"",
    "test:e2e:emulators": "npx --yes firebase-tools@15.17.0 emulators:exec --config firebase.e2e.json --only auth,firestore --project demo-utsav \"playwright test -c playwright.emulators.config.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
