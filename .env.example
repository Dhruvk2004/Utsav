# Utsav environment. Every value is optional: with none set, the app still builds, starts and serves
# its public pages; sign-in shows "Sign-in isn't configured" and plans come from the starter template.

# --- Firebase web config (public, inlined into the client at build time; Docker build args) ---
# authDomain is the app host (e.g. utsav-xyz-el.a.run.app), because /__/auth is proxied same-origin
# to <project>.firebaseapp.com (spec 9.1). Add https://<app host>/__/auth/handler to the OAuth
# client's authorised redirect URIs and the host to Firebase Auth's authorised domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Server-side Firebase (firebase-admin with Application Default Credentials) ---
# Firestore (Native mode) and Cloud Run both live in asia-south1. Deploy rules and indexes with
# `firebase deploy --only firestore` (firebase.json, firestore.rules, firestore.indexes.json).
# Falls back to GOOGLE_CLOUD_PROJECT, then NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Locally, point ADC at a service-account JSON kept OUTSIDE the repo; on Cloud Run the service account is used.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
# Optional local emulators:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Public origin, for CSRF origin checks and share links ---
# Mutations must send this exact Origin. Over plain http (local) the session cookie is not Secure.
APP_ORIGIN=http://localhost:3000

# --- AI ---
# Local development: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-flash-latest)
GEMINI_MODEL=
# On Cloud Run (region asia-south1), use Vertex AI with the service account instead of a key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
